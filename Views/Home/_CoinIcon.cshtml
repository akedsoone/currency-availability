@model AvailabilityLevel?

<svg class="coin-icon @AvailabilityLabels.Key(Model)" viewBox="0 0 26 18" fill="none" stroke="currentColor" stroke-width="1.35"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (Model)
    {
        case AvailabilityLevel.None:
            <ellipse cx="13" cy="7" rx="6.5" ry="2.7" stroke-dasharray="2 2" />
            <path d="M6.5 7v4c0 1.5 2.9 2.7 6.5 2.7s6.5-1.2 6.5-2.7V7" stroke-dasharray="2 2" />
            break;
        case AvailabilityLevel.Low:
            <ellipse cx="13" cy="7" rx="6.5" ry="2.7" />
            <path d="M6.5 7v4c0 1.5 2.9 2.7 6.5 2.7s6.5-1.2 6.5-2.7V7" />
            break;
        case AvailabilityLevel.Enough:
            <ellipse cx="9" cy="6" rx="5.8" ry="2.5" />
            <path d="M3.2 6v4c0 1.4 2.6 2.5 5.8 2.5s5.8-1.1 5.8-2.5V6m.2 1.9c4.5-.5 7.8.8 7.8 2.4s-2.6 2.5-5.8 2.5c-1.1 0-2.2-.1-3.1-.4m-2.7.2v1.2c0 1.4 2.6 2.5 5.8 2.5s5.8-1.1 5.8-2.5v-3.5" />
            break;
        case AvailabilityLevel.High:
            <ellipse cx="13" cy="5" rx="5.1" ry="2.3" />
            <path d="M7.9 5v5.4c0 1.3 2.3 2.3 5.1 2.3s5.1-1 5.1-2.3V5M7.9 7.7c0 1.3 2.3 2.3 5.1 2.3s5.1-1 5.1-2.3m-11.6.8C3.8 8.8 2 9.7 2 10.8c0 1.3 2.3 2.3 5.1 2.3m3.6 1.5c-.9.8-2.6 1.2-4 1.2-2.8 0-4.7-.9-4.7-2.1v-2.9m17.5-2.3c2.7.3 4.5 1.2 4.5 2.3 0 1.3-2.3 2.3-5.1 2.3m-3.6 1.5c.9.8 2.6 1.2 4 1.2 2.8 0 4.7-.9 4.7-2.1v-2.9" />
            break;
        default:
            <path d="M9 9h8" />
            break;
    }
</svg>
